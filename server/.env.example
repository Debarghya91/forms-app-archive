# NoticeMitra server 2.0. Names only; never put real values in git.
# AI providers: Groq (text) + Gemini (vision) only.
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL_TEXT=openai/gpt-oss-120b
GROQ_MODEL_TEXT_FALLBACK=openai/gpt-oss-20b
GROQ_MODEL_VISION=qwen/qwen3.8-27b
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_TIMEOUT_MS=60000
FREE_CALLS_PER_DAY=20
PORT=8080
RATE_LIMIT_MAX=60
# Supabase (configured mode). Unset SUPABASE_URL for pilot mode.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Force 401 without a verified JWT, even in pilot mode.
REQUIRE_AUTH=
# Razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com
# Pilot store path override (tests only; default is server/db.json).
DB_PATH=
