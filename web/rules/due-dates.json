{"due_dates":[{"applicable_to":["salaried","freelancer","sole_proprietor","partnership","llp","private_limited","other"],"category":"tds","frequency":"monthly","key":"tds_deposit","label":"TDS/TCS deposit","rule":"7th of following month","schedule":{"day":7,"kind":"monthly","offset_months":1}},{"applicable_to":["partnership","llp","private_limited","other"],"category":"payroll","frequency":"monthly","key":"pf_esi","label":"PF and ESI deposit","rule":"15th of following month","schedule":{"day":15,"kind":"monthly","offset_months":1}},{"applicable_to":["freelancer","sole_proprietor","partnership","llp","private_limited","other"],"category":"gst","frequency":"monthly","key":"gstr1","label":"GSTR-1","rule":"11th of following month","schedule":{"day":11,"kind":"monthly","offset_months":1}},{"applicable_to":["freelancer","sole_proprietor","partnership","llp","private_limited","other"],"category":"gst","frequency":"monthly","key":"gstr3b","label":"GSTR-3B","rule":"20th of following month","schedule":{"day":20,"kind":"monthly","offset_months":1}},{"applicable_to":["freelancer","sole_proprietor","partnership","llp","private_limited","other"],"category":"gst","frequency":"quarterly","key":"gstr1_qrmp","label":"GSTR-1 (QRMP)","rule":"13th of month after the quarter","schedule":{"day":13,"kind":"quarter_end","offset_months":1}},{"applicable_to":["freelancer","sole_proprietor","partnership","llp","private_limited","other"],"category":"gst","frequency":"quarterly","key":"gstr3b_qrmp","label":"GSTR-3B (QRMP)","rule":"22nd or 24th of month after the quarter, depending on state (22nd used here as the earlier date)","schedule":{"day":22,"kind":"quarter_end","offset_months":1}},{"applicable_to":["freelancer","sole_proprietor","partnership","llp","private_limited","other"],"category":"gst","frequency":"yearly","key":"gstr9","label":"GSTR-9 annual return","note":"Annual return for the preceding financial year. Verify applicability and turnover threshold on the GST portal.","rule":"31 December following the financial year","schedule":{"day":31,"kind":"yearly","month":12}},{"applicable_to":["individual","salaried","freelancer","sole_proprietor","partnership","llp","private_limited","other"],"category":"income_tax","frequency":"yearly","key":"advance_tax_1","label":"Advance tax instalment 1 (15% cumulative)","rule":"15 June","schedule":{"day":15,"kind":"yearly","month":6}},{"applicable_to":["individual","salaried","freelancer","sole_proprietor","partnership","llp","private_limited","other"],"category":"income_tax","frequency":"yearly","key":"advance_tax_2","label":"Advance tax instalment 2 (45% cumulative)","rule":"15 September","schedule":{"day":15,"kind":"yearly","month":9}},{"applicable_to":["individual","salaried","freelancer","sole_proprietor","partnership","llp","private_limited","other"],"category":"income_tax","frequency":"yearly","key":"advance_tax_3","label":"Advance tax instalment 3 (75% cumulative)","rule":"15 December","schedule":{"day":15,"kind":"yearly","month":12}},{"applicable_to":["individual","salaried","freelancer","sole_proprietor","partnership","llp","private_limited","other"],"category":"income_tax","frequency":"yearly","key":"advance_tax_4","label":"Advance tax instalment 4 (100% cumulative)","rule":"15 March","schedule":{"day":15,"kind":"yearly","month":3}},{"applicable_to":["individual","salaried","freelancer","sole_proprietor","other"],"category":"income_tax","frequency":"yearly","key":"itr_individual","label":"ITR filing (individual, no audit)","rule":"31 July","schedule":{"day":31,"kind":"yearly","month":7}},{"applicable_to":["sole_proprietor","partnership","llp","private_limited","other"],"category":"income_tax","frequency":"yearly","key":"tax_audit","label":"Tax audit report","rule":"30 September","schedule":{"day":30,"kind":"yearly","month":9}},{"applicable_to":["sole_proprietor","partnership","llp","private_limited","other"],"category":"income_tax","frequency":"yearly","key":"itr_audit","label":"ITR filing (audit cases)","rule":"31 October","schedule":{"day":31,"kind":"yearly","month":10}},{"applicable_to":["freelancer","sole_proprietor","partnership","llp","private_limited","other"],"category":"tds","frequency":"quarterly","key":"tds_return","label":"TDS return (quarterly)","rule":"31 July, 31 October, 31 January and 31 May for the four quarters","schedule":{"day":31,"kind":"fixed_months","months":[1,5,7,10]}}],"effective_from":"2025-04-01","id":"due-dates","notes":"Standard rules only, checked against the secondary sources listed above on 2026-11-16. Due dates are extended by notification from time to time and a date does not move for a Sunday or holiday unless notified. Every UI using this pack must show a verify on the official portal note. QRMP GSTR-3B is the 22nd or 24th depending on state; this pack uses the 22nd as the earlier date and says so in the rule text. TDS deposit, PF/ESI deposit, and tax audit report entries are carried from the previous app values and were not independently verified in this pass.","sources":[{"accessed":"2026-11-16","publisher":"ComplyKart","title":"GST Return Filing in India: A Practitioner's Guide","url":"https://www.complykart.com/blog/gst-return-filing-complete-guide"},{"accessed":"2026-11-16","publisher":"Indian Business Tools","title":"GST Due Date Calendar: Monthly and Quarterly GSTR-1, 3B, CMP-08","url":"https://www.indianbusinesstools.com/tools/gst-return-due-date-calendar"},{"accessed":"2026-11-16","publisher":"Finance Tools Academy","title":"Income Tax Guide India FY 2025-26: Slabs and Deductions","url":"https://www.financetoolsacademy.com/learn/income-tax-guide.html"},{"accessed":"2026-11-16","publisher":"Dhanaay","title":"Income Tax Slabs FY 2026-27","url":"http://dhanaay.com/s/income-tax-slabs"}],"verified":false,"version":1}